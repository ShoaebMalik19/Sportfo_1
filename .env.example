# Supabase project credentials.
# Get these from your Supabase project: Settings -> API
# Never commit a real .env.local file — it's gitignored by default.

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used in Route Handlers / Server Actions that need elevated
# privileges (e.g. verifying an OTP before a session exists). NEVER expose
# this to the client or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Name of the Supabase Storage bucket used for achievement uploads.
NEXT_PUBLIC_SUPABASE_ACHIEVEMENTS_BUCKET=achievements

# Bucket used for athlete profile photos.
NEXT_PUBLIC_SUPABASE_PHOTOS_BUCKET=athlete-photos

# Public base URL of the deployed site, used to build an absolute URL for the
# social share (Open Graph) image. On Vercel, set this to your deployment URL.
NEXT_PUBLIC_SITE_URL=
